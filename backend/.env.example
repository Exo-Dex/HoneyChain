# Copy this file to .env and fill in real values before running the server.
# .env itself is gitignored - never commit real secrets.

# Used to sign session tokens (services/auth.js). Any long random string works.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-this-with-a-long-random-string

PORT=4000

# development | production - affects session cookie flags (see routes/auth.js)
NODE_ENV=development

# Must match the frontend's dev server origin exactly (scheme+host+port) -
# required for the credentialed CORS request that carries the session cookie.
FRONTEND_ORIGIN=http://localhost:5173
